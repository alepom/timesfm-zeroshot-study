 "methods": {
  "estimator": "nested equal-weight mean of the per-window log ratio (cells domain x horizon, then horizons, then domains)",
  "bootstrap": "two-way multiplicative-weight (pigeonhole) cluster bootstrap: series clusters drawn with replacement within domain strata, times ISO weeks of the first forecast step drawn with replacement (Owen 2007, Ann. Appl. Stat. 1:386-411); one-way over replications on synthetic data",
  "interval": "percentile, 2.5 and 97.5 per cent of the bootstrap distribution of the log estimate, exponentiated",
  "p_value": "two-sided, 2 min(share of replicates >= 0, share <= 0), floored at 1/reps",
  "seed": 17,
  "reps": {
   "R12, R13": 10000,
   "R9, R10, R13 by_horizon": 2000
  },
  "status": "post hoc, not pre-registered; intervals and p-values are unadjusted unless a Holm column is given",
  "R9": "DGP: 10 + 3 sin(2 pi t/24) + 2 sin(2 pi t/168) + AR(1) noise (phi 0.5, innovation sd 0.5), 1,024 points, H 48; upward level shift of size x the marginal noise sd (0.577) starting `lag` steps before the origin; 100 replications per cell, seed 2026, independent draws per cell (no common random numbers); intervals over replications; the best classical model is selected per cell after seeing the results, stat-ens is fixed",
  "R10": "hourly Tier B windows (load, price, weather) with all five configurations; interaction resampled jointly",
  "R17": "per Tier B domain, univariate configurations, complete cases over tfm3-uni, stat-ens, chronos2-uni and naive; two-way bootstrap within the domain, 2,000 draws; descriptive, no multiplicity adjustment",
  "R12": "tasks resampled by source family (22 families in order of first appearance), simple mean of log skill ratios, 10,000 draws, seed 17"
 },
